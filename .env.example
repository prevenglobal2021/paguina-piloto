# Railway te la da automática al agregar el plugin de PostgreSQL
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

PORT=8080

# Contraseña maestra opcional: si la defines, desbloquea CUALQUIER cuenta
# (técnico o admin). Déjala sin definir para desactivar esta puerta trasera.
MASTER_PASSWORD=

# --- Creación automática de tu empresa la primera vez que arranca ---
# Si dejas estas 4 variables definidas, el servidor crea tu empresa y tu
# usuario administrador solo, la primera vez que arranca (no hace falta
# escribir SQL a mano). Después de la primera vez puedes borrarlas si quieres,
# no vuelven a usarse porque ya existe la empresa.
EMPRESA_SLUG=prevenglobal
EMPRESA_NOMBRE=Prevenglobal
ADMIN_USUARIO=tucorreo@ejemplo.com
ADMIN_PASSWORD=CambiaEstaClaveSegura123
